# Copia a .env y rellena los valores. Solo necesitas la API key del proveedor que uses.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
LLM_PROVIDER=openai

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Solo para Streamlit: URL base de esta API (por defecto http://127.0.0.1:8000)
# ESTIMATOR_API_BASE=http://127.0.0.1:8000

# Embeddings y búsqueda semántica (pre-session-06)
# openai | local (local = determinista, sin API; útil en tests)
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
# VECTOR_STORE_PATH=data/vector_store.json
